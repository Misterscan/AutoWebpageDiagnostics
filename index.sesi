/*
  index.sesi — Public API for auto-webpage-diagnostics
  ======================================================
  This is the package entry point. When installed via:
    sesi install github:owner/AutoWebDiagnostics

  Consumers import with:
    allow "AutoWebDiagnostics" in with Diagnostics
    allow "AutoWebDiagnostics" in with {run, seo}
*/

allow "main" in as Main

export fn run(targetUrl: string, outputDir: string) -> object {
  return Main.run(targetUrl, outputDir)
}

export fn performance(page, targetUrl: string) -> object {
  return Main.performance(page, targetUrl)
}

export fn seo(page) -> object {
  return Main.seo(page)
}

export fn accessibility(page) -> object {
  return Main.accessibility(page)
}

export fn security(page, targetUrl: string) -> object {
  return Main.security(page, targetUrl)
}

export fn links(page) -> object {
  return Main.links(page)
}

export fn console(page) -> object {
  return Main.console(page)
}

export fn resources(page) -> object {
  return Main.resources(page)
}

export fn save_report(report: object, outputDir: string) -> string {
  return Main.save_report(report, outputDir)
}

export fn make_separator(label: string) -> string {
  return Main.make_separator(label)
}

export fn pass_icon(ok: bool) -> string {
  return Main.pass_icon(ok)
}

export fn warn_icon(ok: bool) -> string {
  return Main.warn_icon(ok)
}
